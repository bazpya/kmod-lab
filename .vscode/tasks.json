{
    "version": "2.0.0",
    "presentation": {
        "panel": "shared",
        "reveal": "always",
        "focus": true
    },
    "tasks": [
        {
            "label": "build-main",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build-tests",
            "type": "shell",
            "command": "make build/test_all",
            "problemMatcher": "$gcc"
        }
    ]
}